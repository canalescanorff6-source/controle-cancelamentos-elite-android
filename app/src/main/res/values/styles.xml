<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Cancelamentos" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.Cancelamentos.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#101C32</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/elite_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">#101C32</item>
        <item name="postSplashScreenTheme">@style/Theme.Cancelamentos</item>
    </style>
</resources>
